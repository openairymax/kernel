# Airymax LoongArch 64-bit defconfig fragment
# Requires: make ARCH=loongarch defconfig && merge_config.sh -m .config arch/loongarch/configs/airy_defconfig
# This fragment is applied on top of the LoongArch 64-bit base defconfig
# (loongson3_defconfig).
# CONFIG_SECURITY must be enabled for SECURITY_AIRY to take effect
# (SECURITY_AIRY depends on SECURITY && IO_URING).
#
# LoongArch 64-bit support added in v1.0.1 per multi-architecture requirement
# (aligned with openEuler multi-arch: x86_64/aarch64/riscv64/loongarch64).
CONFIG_SECURITY=y
CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
CONFIG_AIRY_LOG=y
CONFIG_AIRY_IPC=y
CONFIG_AIRY_CAP_TABLE_SIZE=1024
# CONFIG_BPF_LSM is not set
CONFIG_IO_URING=y
CONFIG_SCHED_DEADLINE=y
# CONFIG_SCHED_CLASS_EXT is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_EVENTFD=y
CONFIG_DEBUG_INFO_BTF=n
