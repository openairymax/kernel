# Airymax x86_64 defconfig fragment
# 基线来自 airymaxos-kernel.spec 的 %{kbase}（x86_64 为 openeuler_defconfig），
# 本文件只写增量：
#   make ARCH=x86_64 openeuler_defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/x86/configs/airy_defconfig
#   make ARCH=x86_64 olddefconfig
# SECURITY_AIRY depends on SECURITY && IO_URING; both are set below.
CONFIG_SECURITY=y
CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
CONFIG_AIRY_LOG=y
CONFIG_AIRY_IPC=y
CONFIG_AIRY_AGENT_TRACING=y
CONFIG_AIRY_CAP_TABLE_SIZE=1024
# CONFIG_BPF_LSM is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,airy,selinux,smack,tomoyo,apparmor"
CONFIG_IO_URING=y
# 用户命名空间：systemd 单元的 PrivateUsers=/RestrictNamespaces= 与桌面沙箱
# 依赖此项，缺失时 upower 等单元以 217/USER 失败（openEuler 基线同为 y）。
CONFIG_USER_NS=y
CONFIG_SCHED_DEADLINE=y
# CONFIG_SCHED_CLASS_EXT is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_EVENTFD=y
# BTF/BPF 前置（OS-KER-106 / OS-OBS-012）：pahole 需 DWARF 才能生成 BTF，
# 且 DEBUG_INFO_REDUCED/SPLIT 与 DEBUG_INFO_BTF 互斥（lib/Kconfig.debug）。
# airy_lsm 自身不依赖 BPF，此处仅开启内核 BTF/BPF 基线。
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# BPF_EVENTS 位于 kernel/trace/Kconfig 的 `if FTRACE` 区块内，依赖
# (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS；显式开启 FTRACE 与
# KPROBES 保证该链路在各架构 base defconfig 上均成立（OS-KER-106）。
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_BPF_EVENTS=y
# 引导期存储与网络（OP-P0-01）：NVMe 内建进 vmlinuz，使根分区挂载不依赖
# initramfs 是否收进 nvme 模块；I226-V（B50 双网口）由 igc 驱动。
CONFIG_BLK_DEV_NVME=y
CONFIG_IGC=m
# 无 GPU 驱动时的显示通路（真机缺陷 D-06/D-08）。openeuler_defconfig 把
# EFI 帧缓冲留给 fbdev（CONFIG_FB_EFI=y），且 SYSFB_SIMPLEFB 与
# DRM_SIMPLEDRM 均未开，于是 i915 绑定不到设备时既没有 /dev/dri 也没有
# 任何 DRM 输出，Xorg 只能退到 efifb 的单一模式。
# 打开这两项后固件帧缓冲被登记为 simple-framebuffer，simpledrm 提供
# /dev/dri/card0：Xorg 走 modesetting，合成经 llvmpipe 完成。模式列表仍然
# 只有固件给出的那一条，本次改动不解决分辨率枚举（ADR-016 已接受）。
# simpledrm 必须内建：6.6 的 simpledrm.c 只声明 of 匹配表，没有
# MODULE_ALIAS("platform:simple-framebuffer")，做成模块时 udev 拿不到
# modalias 去自动加载，等于装了不用。
#
# DRM 也必须内建：DRM_SIMPLEDRM 是 tristate 且 depends on DRM，而
# openeuler_defconfig 里是 CONFIG_DRM=m，kconfig 会把片段的 =y 静默压回
# =m；merge_config 只报 redefined 不报错，直到打包阶段的 %check 才拦下。
# 这一组配置一旦只生效一半（SYSFB_SIMPLEFB=y 但 simpledrm 没内建），
# sysfb 会去注册 simple-framebuffer 而不再创建 efi-framebuffer，efifb
# 也不绑定，开机连 fbcon 都没有，比不配这组更糟。
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
