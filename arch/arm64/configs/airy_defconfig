# Airymax arm64 defconfig fragment
# Requires: make ARCH=arm64 defconfig && merge_config.sh -m .config arch/arm64/configs/airy_defconfig
# This fragment is applied on top of the arm64 base defconfig.
# SECURITY_AIRY depends on SECURITY && IO_URING; both are set below.
CONFIG_SECURITY=y
CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
CONFIG_AIRY_LOG=y
CONFIG_AIRY_IPC=y
CONFIG_AIRY_CAP_TABLE_SIZE=1024
# CONFIG_BPF_LSM is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,airy,selinux,smack,tomoyo,apparmor"
CONFIG_IO_URING=y
CONFIG_SCHED_DEADLINE=y
# CONFIG_SCHED_CLASS_EXT is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_EVENTFD=y
# BTF/BPF 前置（OS-KER-106 / OS-OBS-012）：pahole 需 DWARF 才能生成 BTF，
# 且 DEBUG_INFO_REDUCED/SPLIT 与 DEBUG_INFO_BTF 互斥（lib/Kconfig.debug）。
# arm64 base defconfig 默认 DEBUG_INFO_REDUCED=y，此处显式关闭。
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# BPF_EVENTS 位于 kernel/trace/Kconfig 的 `if FTRACE` 区块内，依赖
# (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS；显式开启 FTRACE 与
# KPROBES 保证该链路在各架构 base defconfig 上均成立（OS-KER-106）。
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_BPF_EVENTS=y
