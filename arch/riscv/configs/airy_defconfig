# Airymax RISC-V 64-bit defconfig fragment
# Requires: make ARCH=riscv defconfig && merge_config.sh -m .config arch/riscv/configs/airy_defconfig
# This fragment is applied on top of the RISC-V 64-bit base defconfig.
# SECURITY_AIRY depends on SECURITY && IO_URING; both are set below.
#
# RISC-V 64-bit support added in v1.0.1 per multi-architecture requirement
# (aligned with openEuler multi-arch: x86_64/aarch64/riscv64/loongarch64).
CONFIG_SECURITY=y
CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
CONFIG_AIRY_LOG=y
CONFIG_AIRY_IPC=y
CONFIG_AIRY_AGENT_TRACING=y
CONFIG_AIRY_CAP_TABLE_SIZE=1024
# CONFIG_BPF_LSM is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,airy,selinux,smack,tomoyo,apparmor"
CONFIG_IO_URING=y
# 用户命名空间：systemd 单元的 PrivateUsers=/RestrictNamespaces= 与桌面沙箱
# 依赖此项，缺失时 upower 等单元以 217/USER 失败（openEuler 基线同为 y）。
CONFIG_USER_NS=y
CONFIG_SCHED_DEADLINE=y
# CONFIG_SCHED_CLASS_EXT is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_EVENTFD=y
# BTF/BPF 前置（OS-KER-106 / OS-OBS-012）：pahole 需 DWARF 才能生成 BTF，
# 且 DEBUG_INFO_REDUCED/SPLIT 与 DEBUG_INFO_BTF 互斥（lib/Kconfig.debug）。
# airy_lsm 自身不依赖 BPF，此处仅开启内核 BTF/BPF 基线。
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# 非特权 BPF 默认关闭：本产品不向非特权用户开放 BPF 程序加载，它本身就是
# 可利用的攻击面，也是 x86 上 eIBRS 生效时内核在 0.06 s 打印的那条
# "Spectre V2 : WARNING: Unprivileged eBPF is enabled" 的唯一来源——
# arch/x86/kernel/cpu/bugs.c 的 spectre_v2_select_mitigation() 以
# unprivileged_ebpf_enabled() 为条件，而该值来自 sysctl 初值。这一行早于
# 任何用户态 sysctl.d 生效，默认值只能由编译期决定：=y 时初值为 2（永久
# 关闭），管理方仍可下调到 0。四架构同一口径，不把加固只落在 x86。
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# BPF_EVENTS 位于 kernel/trace/Kconfig 的 `if FTRACE` 区块内，依赖
# (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS；显式开启 FTRACE 与
# KPROBES 保证该链路在各架构 base defconfig 上均成立（OS-KER-106）。
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_BPF_EVENTS=y
