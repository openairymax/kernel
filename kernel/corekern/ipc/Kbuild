obj-y += airy_ck_ipc.o

airy_ck_ipc-y := airy_ipc_ring.o airy_ipc_fastpath.o airy_ipc_zero_copy.o
airy_ck_ipc-y += airy_ipc_crc32.o airy_ipc_trace.o
airy_ck_ipc-y += airy_ipc_check.o

# KUnit regression for the stateless Layout C v4 header contract that the
# io_uring data plane and syscall 548 share (C-S1/C-S3/C-S4/C-S10).
airy_ck_ipc-$(CONFIG_AIRY_KUNIT) += airy_ipc_check_test.o

# KUnit regression for the IPC ring core (capacity/teardown, cursor
# semantics, cancelBadgedSends, depth accounting).  The ring entry points
# are non-static (airy_ipc_internal.h), so airy_ipc_ring.o stays in the link.
airy_ck_ipc-$(CONFIG_AIRY_KUNIT) += airy_ipc_ring_test.o
airy_ck_ipc-$(CONFIG_AIRY_KUNIT) += airy_ipc_crc32_test.o

# KUnit regression for the IPC trace emission: field fidelity of
# airy_ipc_send/airy_ipc_recv, agent-id normalisation and the *_on()
# predicates that gate fastpath timestamping.
airy_ck_ipc-$(CONFIG_AIRY_KUNIT) += airy_ipc_trace_test.o

# IPC fastpath micro-benchmark (v3.6 closure: replaces ~10ns/~158ns design
# estimates with measured data).  Linked when CONFIG_AIRY_KUNIT=y; the suite
# reports mean/p50/p99 via KUNIT_INFO for collection under UML or hardware.
airy_ck_ipc-$(CONFIG_AIRY_KUNIT) += airy_fastpath_bench.o
