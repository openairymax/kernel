#
# Airymax observation surface (/sys/airy, /proc/airy)
#

obj-$(CONFIG_AIRY_OBS) += airy_obs.o

airy_obs-y := airy_obs_core.o airy_obs_sec.o airy_obs_superv.o \
	      airy_obs_daemons.o airy_uevent.o airy_obs_proc.o

# The scheduling, IPC and log nodes read counters owned by subsystems that
# only exist in a full build.  KUnit does not enable them, so the table has
# to follow the same condition as the code it reads.
airy_obs-$(CONFIG_AIRY_COREKERN) += airy_obs_sched.o airy_obs_ipc.o
airy_obs-$(CONFIG_AIRY_LOG) += airy_obs_log.o

# The debug surface complements /sys/airy with raw detail that has no stable
# ABI: capability slot contents, the full last verdict and the log ring
# bytes.  It is optional, so the object follows CONFIG_DEBUG_FS.
airy_obs-$(CONFIG_DEBUG_FS) += airy_obs_debugfs.o

airy_obs-$(CONFIG_AIRY_KUNIT) += airy_obs_test.o
