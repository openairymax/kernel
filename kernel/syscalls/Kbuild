obj-$(CONFIG_AIRY_SYSCALL) += airy_syscalls.o
obj-$(CONFIG_AIRY_SYSCALL) += airy_sysabi.o
obj-$(CONFIG_AIRY_SYSCALL) += airy_clt.o
obj-$(CONFIG_AIRY_SYSCALL) += airy_rovol.o
obj-$(CONFIG_AIRY_SYSCALL) += airy_sched.o

# KUnit regression for the syscall 548 control-plane entry: the
# C-S1/C-S3/C-S4/C-S10 header contract, the opcode plane classifier and
# the opcode/ordering rules of the dispatch entry, plus the two badge
# lifecycle handlers — the CAP_RESPONSE badge-install and the FREEZE
# badge-revoke paths.
# airy_invoke_test.c links against the non-static airy_invoke_hdr_check(),
# airy_invoke_op_valid(), airy_invoke_dispatch(), airy_badge_install() and
# airy_badge_revoke() defined in airy_syscalls.c.
obj-$(CONFIG_AIRY_KUNIT) += airy_invoke_test.o

# KUnit regression for the syscall 551 phase record: the boundary
# contract of airy_clt_notify(), the read-back of airy_clt_query() and
# the AIRY_CLT_PHASE_UNSET sentinel that marks a never-notified agent.
# airy_clt_test.c links against the non-static airy_clt_notify() and
# airy_clt_query() defined in airy_clt.c.
obj-$(CONFIG_AIRY_KUNIT) += airy_clt_test.o

# KUnit regression for the syscall 549 MemoryRoVol entry: the
# registry-backed op check of airy_rovol_serve() and its fail-closed
# split into -AIRY_EINVAL for an undefined op and the -AIRY_ENOTSUP
# milestone M5 degradation for a recognised one.
# airy_rovol_test.c links against the non-static airy_rovol_serve()
# defined in airy_rovol.c.
obj-$(CONFIG_AIRY_KUNIT) += airy_rovol_test.o

# KUnit regression for the syscall 550 sched_tac entry: the
# registry-backed op check of airy_sched_serve() and its fail-closed
# split into -AIRY_EINVAL for an undefined op and the -AIRY_ENOTSUP
# milestone M3 degradation for a recognised one.
# airy_sched_test.c links against the non-static airy_sched_serve()
# defined in airy_sched.c.
obj-$(CONFIG_AIRY_KUNIT) += airy_sched_test.o

# KUnit regression for the core syscall registry: the immutable and
# ascending 548-551 number block, the argument counts and operation
# sources each descriptor publishes, the half-open operation interval
# airy_op_check() enforces with its refusal magnitude, and the version
# negotiation verdict matrix (SSoT §8.2, §13.1).
# airy_sysabi_test.c links against the non-static airy_desc_find(),
# airy_op_check() and airy_abi_verdict() defined in airy_sysabi.c.
obj-$(CONFIG_AIRY_KUNIT) += airy_sysabi_test.o
