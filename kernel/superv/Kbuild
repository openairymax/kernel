# Micro-Supervisor — kernel/superv/
#
# Files renamed with _superv suffix per OS-STD-001 to resolve name clashes
# with security/airy/ (airy_cap_check.c, airy_die_notify.c,
# airy_eventfd.c, airy_ipc_freeze.c).

obj-$(CONFIG_SECURITY_AIRY) += airy_superv.o

airy_superv-y := airy_superv_init.o \
                 airy_cap_check_superv.o \
                 airy_eventfd_superv.o \
                 airy_ipc_freeze_superv.o \
                 airy_superv_proto.o \
                 airy_superv_task.o \
                 airy_superv_ring.o \
                 airy_superv_adjud.o \
                 airy_superv_fault.o \
                 airy_superv_exec.o \
                 airy_superv_wdog.o

# KUnit regression for the [IND] supervisor protocol contract: the
# IDLE->RUNNING gate that keeps commands out of a half-built ring, the
# shape check every macro_d command passes before any ring or task
# state is touched, the ring transitions that walk the process list to
# freeze or thaw every ring owned by the target agent, the verdict
# executor that pauses, degrades or terminates the agent's tasks, the
# security fault observer that forwards slowpath violations to macro_d,
# the [IND] command entry that authorises the caller and dispatches,
# and the liveness guard that contains the system when macro_d stops
# sending heartbeats.
airy_superv-$(CONFIG_AIRY_KUNIT) += airy_superv_proto_test.o \
                                    airy_superv_ring_test.o \
                                    airy_superv_adjud_test.o \
                                    airy_superv_fault_test.o \
                                    airy_superv_exec_test.o \
                                    airy_superv_wdog_test.o
