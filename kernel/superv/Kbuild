# Micro-Supervisor — kernel/superv/
#
# Files renamed with _superv suffix per OS-STD-001 to resolve name clashes
# with security/airy/ (airy_cap_check.c, airy_die_notify.c,
# airy_eventfd.c, airy_ipc_freeze.c).

obj-$(CONFIG_SECURITY_AIRY) += airy_superv.o

airy_superv-y := airy_superv_init.o \
		 airy_cap_check_superv.o \
		 airy_eventfd_superv.o \
		 airy_ipc_freeze_superv.o \
		 airy_superv_proto.o

# KUnit regression for the [IND] supervisor protocol contract: the
# IDLE->RUNNING gate that keeps commands out of a half-built ring, and
# the shape check every macro_d command passes before any ring or task
# state is touched.
airy_superv-$(CONFIG_AIRY_KUNIT) += airy_superv_proto_test.o
