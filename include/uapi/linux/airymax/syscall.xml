  v1.0.1 Capability Folding 后的权威 syscall.xml 内容：
    - 4 核心 syscall + 20 预留 = 24 槽位
    - 编号起点 548（避开 x86_64 x32 历史遗留区域 512-547）
-->
<syscalls version="0x0100"
          core_count="4"
          reserved_count="20"
          total_slots="24"
          linux_base="548">

  <!-- 元数据：生成器与模板版本锁定 -->
  <meta>
    <generator>syscall_gen.py</generator>
    <generator_version>1.0.1</generator_version>
    <schema_version>1.0</schema_version>
    <prefix_symbol>AIRY_SYS_</prefix_symbol>
    <prefix_function>airy_sys_</prefix_function>
  </meta>

  <!--
    单个 syscall 定义。
    字段：
      name                 小写函数名（airy_sys_call）
      number               内部编号（0-23），Linux 注册号 = number + linux_base
      signature            C 函数签名（参数列表）
      capability_required  调用所需 capability ID（可选，0 表示无）
      flags                标志位（blocking / nonblocking / control / notify）
      since                引入版本
      stability            ABI 稳定性（stable / experimental / deprecated）
  -->
  <syscall>
    <name>airy_sys_call</name>
    <number>0</number>
    <signature>cap_t cap, const struct airy_ipc_msg_hdr *msg</signature>
    <flags>blocking</flags>
    <category>ipc_primitive</category>
    <since>1.0.1</since>
    <stability>stable</stability>
    <doc>Unified capability invocation (sec_d 专属管理入口).</doc>
  </syscall>

  <syscall>
    <name>airy_sys_rovol_ctl</name>
    <number>1</number>
    <signature>__u32 op, __u32 pid, __u64 arg</signature>
    <flags>control</flags>
    <category>control_primitive</category>
    <since>1.0.1</since>
    <stability>stable</stability>
    <doc>Reverse-of-volatility (rovol) control operations.</doc>
  </syscall>

  <syscall>
    <name>airy_sys_sched_ctl</name>
    <number>2</number>
    <signature>__u32 op, const char *cgroup_path, const char *policy</signature>
    <flags>control</flags>
    <category>control_primitive</category>
    <since>1.0.1</since>
    <stability>stable</stability>
    <doc>Scheduler control operations (sched_tac policy via cgroup path + policy string).</doc>
  </syscall>

  <syscall>
    <name>airy_sys_clt_notify</name>
    <number>3</number>
    <signature>int task_id, __u32 phase</signature>
    <flags>control</flags>
    <category>control_primitive</category>
    <since>1.0.1</since>
    <stability>stable</stability>
    <doc>CoreLoopThree phase notification + kthread control (phase: PERCEPT/THINK/ACT).</doc>
  </syscall>

  <!-- 4-23: 预留槽位，不生成实现，仅占用编号 -->
  <reserved from="4" to="23" reason="future extension"/>

</syscalls>
