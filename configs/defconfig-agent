# ALK-6.6 agent-optimized defconfig fragment

CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
CONFIG_AIRY_LOG=y
CONFIG_AIRY_IPC=y
CONFIG_AIRY_CAP_TABLE_SIZE=2048
CONFIG_IO_URING=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_MEMORY=y
CONFIG_DRM_SCHED=y
CONFIG_CXL_BUS=y
CONFIG_ZONE_DEVICE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_MEMCG=y
CONFIG_NUMA_BALANCING=y

#
# IRON-7: override openEuler-specific core subsystem tweaks back to vanilla defaults.
# These openEuler extensions do not exist in vanilla 6.6 and conflict with
# agent-linux microkernel enhancements (sched_tac / airy_lsm / memory model).
# Apply this fragment on top of openeuler_defconfig to neutralize them.
#

# Scheduler: disable openEuler-specific sched extensions
# CONFIG_SCHED_CLASS_EXT is not set
# CONFIG_SCHED_STEAL is not set
# CONFIG_SCHED_PARAL is not set
# CONFIG_SCHED_SOFT_QUOTA is not set
# CONFIG_SCHED_SOFT_DOMAIN is not set

# Memory cgroup: disable openEuler-specific memcg extensions (keep vanilla MEMCG=y)
# CONFIG_MEMCG_QOS is not set
# CONFIG_MEMCG_MEMFS_INFO is not set
# CONFIG_MEMCG_OOM_PRIORITY is not set
# CONFIG_MEMCG_SWAP_QOS is not set
# CONFIG_MEMCG_KMEM_STOCK is not set

# NUMA: disable openEuler-specific NUMA extensions (keep vanilla NUMA/BALANCING)
# CONFIG_NUMA_AWARE_SPINLOCKS is not set
# CONFIG_NUMA_EMU is not set
# CONFIG_NUMABALANCING_MEM_SAMPLING is not set

# Security: disable openEuler-specific security bypass
# CONFIG_SECURITY_FEATURE_BYPASS is not set

# LSM: keep BPF_LSM off (airy_lsm provides hook surface, not BPF-based)
# CONFIG_BPF_LSM is not set

# Real-time bandwidth: keep the vanilla global RT budget. With
# CONFIG_RT_GROUP_SCHED=y systemd gives every slice a share of the root
# runtime but leaves leaf unit cgroups at cpu.rt_runtime_us=0, so a thread
# inside a unit asking for SCHED_RR gets EPERM even for root. rtkit then
# prints "Failed to make ourselves RT" on every boot and desktop audio
# never reaches a real-time priority. Measured on hardware: chrt -r fails
# in a cgroup with rt_runtime_us=0 and succeeds at 190000.
# CONFIG_RT_GROUP_SCHED is not set

# IMA/EVM built-in key paths: openeuler_defconfig enables
# CONFIG_IMA_LOAD_X509 and CONFIG_EVM_LOAD_X509 pointing at
# /etc/keys/x509_ima.der and /etc/keys/x509_evm.der. No package ships
# those files, so kernel init prints one "integrity: Unable to open file"
# per path on every boot. Keep the loaders off until the trust chain
# provides real key material.
# CONFIG_IMA_LOAD_X509 is not set
# CONFIG_EVM_LOAD_X509 is not set
