# SPDX-License-Identifier: GPL-2.0-only
# ALK-6.6 hardening.config — security hardening fragment (three-stage defconfig)
#
# Three-stage defconfig design (borrowed from openEuler OLK-6.6):
#   Stage 1: base defconfig         (configs/defconfig)
#   Stage 2: hardening fragment     (configs/hardening.config)  ← this file
#   Stage 3: scenario fragment      (configs/defconfig-agent | configs/defconfig-embedded)
#
# Usage:
#   make defconfig && \
#   scripts/kconfig/merge_config.sh -m .config \
#       configs/defconfig configs/hardening.config configs/defconfig-agent
#
# Design principles:
#   * All options here have low (or no) performance impact on most workloads.
#   * No BPF-dependent options (H5: Airy is a pure-C LSM, no BPF verifier).
#   * No sched_ext or any BPF_JIT/BPF_SYSCALL requirement.
#   * Compatible with IRON-1~9 and [SC] single-host principle.
#   * References: openEuler OLK-6.6 kernel/configs/hardening.config +
#                 arch/x86/configs/hardening.config

# ─── Section 1: Reporting & Memory Permission Enforcement ──────────────
# Make sure reporting of various hardening actions is possible.
CONFIG_BUG=y

# Basic kernel memory permission enforcement.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_VMAP_STACK=y

# ─── Section 2: ASLR (Address Space Layout Randomization) ──────────────
# Kernel image and memory ASLR.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Randomize kernel stack offset on syscall entry.
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# ─── Section 3: Allocator Hardening ────────────────────────────────────
# Randomize allocator freelists, harden metadata.
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOM_KMALLOC_CACHES=y

# Initialize all heap variables to zero on allocation.
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# Initialize all stack variables to zero on function entry.
CONFIG_INIT_STACK_ALL_ZERO=y

# ─── Section 4: Stack & Buffer Overflow Protection ─────────────────────
# Basic stack frame overflow protection.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Basic buffer length bounds checking.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# ─── Section 5: Array Index Bounds Checking ────────────────────────────
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_BOUNDS=y
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set
CONFIG_UBSAN_SANITIZE_ALL=y

# Linked list integrity checking (Linux 6.6+).
CONFIG_LIST_HARDENED=y

# ─── Section 6: DMA & IOMMU Hardening ──────────────────────────────────
# Disable DMA between EFI hand-off and the kernel's IOMMU setup.
CONFIG_EFI_DISABLE_PCI_DMA=y

# Force IOMMU TLB invalidation so devices never access stale data.
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# Do not allow direct physical memory access to non-device memory.
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# ─── Section 7: Syscall Attack Surface Reduction ───────────────────────
# Provide userspace with seccomp API for syscall attack surface reduction.
# Note: seccomp BPF is allowed for userspace syscall filtering; this does
# not conflict with H5 (Airy LSM is pure-C) because the Airy LSM itself
# does not register any BPF programs.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ─── Section 8: Network Hardening ──────────────────────────────────────
# Provides some protections against SYN flooding.
CONFIG_SYN_COOKIES=y

# ─── Section 9: Attack Surface Reduction ───────────────────────────────
# Do not autoload TTY line disciplines.
# CONFIG_LDISC_AUTOLOAD is not set

# Dangerous; enabling this disables userspace brk ASLR.
# CONFIG_COMPAT_BRK is not set

# Dangerous; exposes kernel text image layout.
# CONFIG_PROC_KCORE is not set

# Dangerous; enabling this disables userspace VDSO ASLR.
# CONFIG_COMPAT_VDSO is not set

# Use the modern PTY interface (devpts) only.
# CONFIG_LEGACY_PTYS is not set

# Use only modesetting video drivers.
# CONFIG_DRM_LEGACY is not set

# ─── Section 10: x86-specific Hardening ────────────────────────────────
# Modern libc no longer needs a fixed-position mapping in userspace.
CONFIG_LEGACY_VSYSCALL_NONE=y

# Enable chip-specific IOMMU support.
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_INTEL_IOMMU_SVM=y
CONFIG_AMD_IOMMU=y

# Enable CET Shadow Stack for userspace.
CONFIG_X86_USER_SHADOW_STACK=y

# ─── Section 11: Airymax-specific Hardening ────────────────────────────
# Ensure the security subsystem is enabled (Airy pure-C LSM depends on it).
CONFIG_SECURITY=y

# Wipe RAM at reboot via EFI (reset attack mitigation).
CONFIG_RESET_ATTACK_MITIGATION=y
