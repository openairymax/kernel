# ALK-6.6 embedded defconfig fragment (minimal footprint)

CONFIG_SECURITY_AIRY=y
CONFIG_AIRY_OBS=y
# Trace transport stays off in the minimal profile; /sys/airy/events then
# reports "absent" instead of advertising a channel that is not compiled in.
# CONFIG_USER_EVENTS is not set
CONFIG_AIRY_SYSCALL=y
CONFIG_AIRY_COREKERN=y
# CONFIG_AIRY_LOG is not set
# CONFIG_AIRY_IPC is not set
CONFIG_AIRY_CAP_TABLE_SIZE=256
CONFIG_IO_URING=y
# CONFIG_BPF is not set
# CONFIG_CGROUPS is not set
