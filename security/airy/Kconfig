# Airy Pure-C LSM — Kernel Configuration
#

config SECURITY_AIRY
	bool "Airymax Pure-C LSM (Airy)"
	depends on SECURITY
	depends on IO_URING
	select AIRY_IPC
	select AIRY_COREKERN
	select AIRY_SYSCALL
	select AIRY_LOG
	default n
	help
	  A pure-C Linux Security Module for the Airymax agent runtime.
	  Provides capability-based security, agent lifecycle supervision,
	  IPC ring freezing, and die_notifier fault handling.

	  Unlike BPF-based LSMs, Airy implements all hooks directly in C,
	  enabling formal verification and deterministic enforcement.

	  If unsure, say N.

config AIRY_IPC
	bool "Airymax IPC fabric (kernel/ipc)"
	default n
	help
	  Airymax IPC capability and ring-buffer support. Provides the
	  global agent_caps[] array and airy_cap_agent_caps_init() required
	  by the Airy LSM. Selected automatically by SECURITY_AIRY.

config AIRY_COREKERN
	bool "Airymax core-kernel enhancements (kernel/corekern)"
	default n
	help
	  Airymax core-kernel subsystems: IPC fastpath, memory tiers,
	  task lifecycle, locking, time, IRQ, object system. Selected
	  automatically by SECURITY_AIRY.

config AIRY_SYSCALL
	bool "Airymax syscall surface (kernel/syscalls)"
	default n
	help
	  Airymax system calls (548-551). Selected automatically by
	  SECURITY_AIRY.

config AIRY_LOG
	bool "Airymax logging subsystem (kernel/log)"
	default n
	help
	  Airymax unified logging and printk ring buffer. Selected
	  automatically by SECURITY_AIRY.

config AIRY_CAP_TABLE_SIZE
	int "Airy capability table size"
	depends on SECURITY_AIRY
	default 1024
	range 64 4096
	help
	  Number of capability slots in the global agent capability table.
	  Each slot is 64 bytes. Total memory = AIRY_CAP_TABLE_SIZE * 64.

config AIRY_KUNIT
	bool "Airy KUnit regression tests" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on SECURITY_AIRY
	default KUNIT_ALL_TESTS
	help
	  KUnit regression tests for the Airy P1 fixes (P1-1/4/5/8/10) plus the
	  IPC fastpath micro-benchmark (v3.6 closure item: measured Badge and
	  fastpath latency replacing design estimates).  Builds:
	    - security/airy/airy_lsm_test.c            (P1-4 Badge validation)
	    - security/airy/airy_cap_derive_test.c     (P1-10 COPY downgrade)
	    - kernel/ipc/airy_ipc_capability_test.c    (P1-5 AIRY_ALIGNED layout)
	    - kernel/corekern/ipc/airy_ipc_ring_test.c (P1-8 cancelBadgedSends)
	    - kernel/corekern/ipc/airy_fastpath_bench.c (fastpath micro-benchmark)
	    - kernel/corekern/sched/stc_dispatch_test.c (P1-1 log rate-limit)

	  Each test exercises the fixed path with no functional change to
	  production code.  Say N if unsure.
